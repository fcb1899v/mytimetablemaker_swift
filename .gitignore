# Xcode
.DS_Store
*/build/*
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
# Was a bare `project.xcworkspace` until 2026-09-19. That excluded the whole
# directory, and git cannot re-include a file whose parent directory is
# excluded, so Package.resolved could not be tracked. Opened one level at a
# time instead, which keeps everything else in there excluded by default:
# a file Xcode invents later stays out until someone adds a line for it
**/project.xcworkspace/*
!**/project.xcworkspace/contents.xcworkspacedata
!**/project.xcworkspace/xcshareddata/
**/project.xcworkspace/xcshareddata/*
!**/project.xcworkspace/xcshareddata/swiftpm/
**/project.xcworkspace/xcshareddata/swiftpm/*
!**/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
iOSInjectionProject/

# Backup files
*.backup
*.backup2

# Security - Firebase configuration files
# Not GoogleService-Info.plist: the Xcode project lists it in its Resources
# build phase, so the build needs it. It holds the project identifiers that ship
# inside the app anyway, which is why hiding it protected nothing.

# Security - API configuration files
APIConfig.plist
*APIConfig*.plist

# Security - build configuration files holding real credentials.
# Debug was tracked until 2026-09-06 while Release was not, so the ODPT
# tokens and the AdMob unit id reached the history. Both are excluded now.
Release.xcconfig
Debug.xcconfig

# Environment variables
.env
.env.local
.env.development
.env.production

# User-specific files
*.xcuserdatad/
xcuserdata/

# Package manager: Package.resolved is tracked, see the rules above

# Workspace tooling, not part of this app. Six of the other repos already
# hide it; keeping one set of rules means the same review applies everywhere.
.claude/
.cursorignore

# --- Signing assets (added 2026-09-06) ---
# None of these are in any repository today. The rules exist so that a
# certificate exported to the project directory for a one-off cannot be
# committed by a later `git add -A`. Distribution certificates and the App
# Store Connect key grant publishing rights, and a leak is not fixed by
# deleting the file: the history keeps it.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
build/
*.bak


# --- Firebase configuration (added 2026-09-19) ---
# Anything regenerable stays out. The console hands these back on request, so
# tracking them only publishes the project identifiers for nothing. This does
# not make them secret: the plist's API key ships inside every copy of the app,
# and Firestore rules and App Check are what deny access.
# CONFIGURATION.md lists every file a clone still has to create by hand.
GoogleService-Info.plist
firebase.json
.firebaserc
